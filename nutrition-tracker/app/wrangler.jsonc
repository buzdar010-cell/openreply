{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrition-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutrition-tracker-db",
      // Placeholder -- real value is assigned when `wrangler d1 create`
      // is run against an actual Cloudflare account. Local dev/testing
      // works fine without this being real.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nutrition-tracker-photos"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "GeminiRateLimiterDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GeminiRateLimiterDO"]
    }
  ]
}
